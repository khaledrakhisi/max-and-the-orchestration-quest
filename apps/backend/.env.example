PORT=8000
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Default single-player user
PRIMARY_USER_ID=693843f9a8cdbf214cd36a62
PRIMARY_USER_EMAIL=player1@example.com

# Logging
ENABLE_MONGO_LOGGING=0
DISABLE_APP_LOGGING=0
